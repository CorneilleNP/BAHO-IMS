# Copy to .env on the VPS only. Do not commit the real file.
COMPOSE_PROJECT_NAME=baho-ims-production

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=baho.izere.work
DJANGO_SECURE_SSL_REDIRECT=true
CSRF_TRUSTED_ORIGINS=https://baho.izere.work

POSTGRES_DB=baho_ims
POSTGRES_USER=baho
# Use a URL-safe value, for example: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-password