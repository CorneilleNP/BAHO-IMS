# Copy to .env on the VPS only. Do not commit the real file.
COMPOSE_PROJECT_NAME=baho-ims-production

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=baho.izere.work
DJANGO_SECURE_SSL_REDIRECT=true
CSRF_TRUSTED_ORIGINS=https://baho.izere.work

POSTGRES_DB=baho_ims
POSTGRES_USER=baho
# Use a URL-safe value, for example: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-password

# --- Optional ---------------------------------------------------------------
# Error monitoring: paste the project's DSN from sentry.io (leave empty to disable).
SENTRY_DSN=
# Swagger at /api/docs/ (staff users only). Keep false unless needed.
API_DOCS_ENABLED=false
# Nightly database backups into ./backups (copy them off the server!).
BACKUP_HOUR=1
BACKUP_KEEP_DAYS=14
# SMS to farmers: "console" only logs; "africastalking" sends for real.
SMS_BACKEND=console
SMS_SENDER_ID=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
